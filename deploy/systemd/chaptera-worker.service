[Unit]
Description=Chaptera Cloud durable worker
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/chaptera /var/spool/chaptera

[Service]
Type=simple
User=chaptera
Group=chaptera
Slice=chaptera.slice
WorkingDirectory=/var/lib/chaptera

# CLOUD-ASYNC-RUNTIME-01 owns exact worker execution semantics.
# The worker parses the same typed config but is intentionally not given AuthN secrets.
ExecStart=/opt/chaptera/current/chaptera --config /etc/chaptera/chaptera.toml worker

Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=60s

StateDirectory=chaptera
CacheDirectory=chaptera-worker
RuntimeDirectory=chaptera-worker
EnvironmentFile=-/etc/chaptera/chaptera.env
ReadWritePaths=/var/spool/chaptera

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

MemoryHigh=384M
MemoryMax=640M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
