{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptera.dev/schema/web/export-preview.v1.json",
  "title": "Chaptera source-free export preview V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "report_schema_version",
    "document_id",
    "source_hash",
    "revision_id",
    "target",
    "can_serialize",
    "counts",
    "items"
  ],
  "properties": {
    "protocol_version": {"const": "chaptera.export-preview.v1"},
    "report_schema_version": {"const": "0.1"},
    "document_id": {"$ref": "#/$defs/uuid"},
    "source_hash": {"$ref": "#/$defs/sha256"},
    "revision_id": {"$ref": "#/$defs/hashId"},
    "target": {"$ref": "#/$defs/target"},
    "conversion_fence_sha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "can_serialize": {"type": "boolean"},
    "counts": {"$ref": "#/$defs/counts"},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "adapter_version", "profile"],
      "properties": {
        "format": {"enum": ["idml", "odg"]},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "profile": {"type": "string", "minLength": 1, "maxLength": 128},
        "schema_fence": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserved",
        "approximated",
        "flattened",
        "rasterized",
        "unsupported",
        "blocking"
      ],
      "properties": {
        "preserved": {"type": "integer", "minimum": 0},
        "approximated": {"type": "integer", "minimum": 0},
        "flattened": {"type": "integer", "minimum": 0},
        "rasterized": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "blocking": {"type": "integer", "minimum": 0}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "disposition"],
      "properties": {
        "feature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "origin": {"$ref": "#/$defs/uuid"},
        "property_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "disposition": {
          "enum": ["preserved", "approximated", "flattened", "rasterized", "unsupported"]
        },
        "loss_kind": {
          "enum": [
            "approximated",
            "flattened",
            "rasterized",
            "text_reflowed",
            "font_substituted",
            "unsupported",
            "source_extension_lost"
          ]
        },
        "severity": {
          "enum": ["info", "visual", "semantic", "structural", "blocking"]
        },
        "reversible": {"type": "boolean"},
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
