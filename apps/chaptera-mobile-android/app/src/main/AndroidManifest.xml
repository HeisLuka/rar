<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:label="Chaptera Reader"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-mspublisher" />
                <data android:mimeType="application/vnd.ms-publisher" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!--
              Many Android document providers do not know the Microsoft Publisher MIME type
              and surface .pub files as a generic/unknown document. Accept generic VIEW
              intents here and let the Rust admission layer decide whether the supplied bytes
              are actually a supported PUB. This intentionally favors reliable "Open with"
              discovery over MIME-only filtering.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
