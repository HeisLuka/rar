{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptera.local/protocol/authoring-create-shape/v1/create-shape-intent.schema.json",
  "title": "Chaptera CreateShape intent V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "document_id", "source_hash", "base_revision_id", "client_operation_id", "command"],
  "properties": {
    "protocol_version": {"const": "chaptera.create-shape-intent.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_revision_id": {"type": "string", "minLength": 1},
    "client_operation_id": {"type": "string", "minLength": 1},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_id", "page_id", "bounds", "paint"],
      "properties": {
        "kind": {"const": "create_shape"},
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "page_id": {"type": "string", "minLength": 1},
        "bounds": {"$ref": "#/$defs/rect"},
        "paint": {"$ref": "#/$defs/paint"}
      }
    }
  },
  "$defs": {
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b"],
      "properties": {
        "r": {"type": "integer", "minimum": 0, "maximum": 255},
        "g": {"type": "integer", "minimum": 0, "maximum": 255},
        "b": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "color"],
      "properties": {
        "visible": {"type": "boolean"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "color", "width_emu"],
      "properties": {
        "visible": {"type": "boolean"},
        "color": {"$ref": "#/$defs/color"},
        "width_emu": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "paint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fill", "stroke"],
      "properties": {
        "fill": {"$ref": "#/$defs/fill"},
        "stroke": {"$ref": "#/$defs/stroke"}
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        "y": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        "width": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "height": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    }
  }
}
