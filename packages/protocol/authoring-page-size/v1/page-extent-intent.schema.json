{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptera.example/protocol/authoring-page-size/v1/page-extent-intent.schema.json",
  "title": "Chaptera page extent intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "document_id", "source_hash", "base_revision_id", "client_operation_id", "command"],
  "properties": {
    "protocol_version": {"const": "chaptera.page-extent-intent.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_revision_id": {"type": "string", "minLength": 1},
    "client_operation_id": {"type": "string", "minLength": 8},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page_id", "expected_before", "after", "semantics"],
      "properties": {
        "kind": {"const": "set_page_extent"},
        "page_id": {"type": "string", "minLength": 1},
        "expected_before": {"$ref": "#/$defs/extent"},
        "after": {"$ref": "#/$defs/extent"},
        "semantics": {"const": "keep_objects_fixed"}
      }
    }
  },
  "$defs": {
    "extent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_emu", "height_emu"],
      "properties": {
        "width_emu": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "height_emu": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    }
  }
}
