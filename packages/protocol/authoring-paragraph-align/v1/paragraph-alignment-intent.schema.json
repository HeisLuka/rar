{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptera.example/protocol/authoring-paragraph-align/v1/paragraph-alignment-intent.schema.json",
  "title": "Chaptera paragraph alignment intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_id",
    "source_hash",
    "base_revision_id",
    "client_operation_id",
    "command"
  ],
  "properties": {
    "protocol_version": {"const": "chaptera.paragraph-alignment-intent.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_revision_id": {"type": "string", "minLength": 1},
    "client_operation_id": {"type": "string", "minLength": 8},
    "command": {
      "oneOf": [
        {"$ref": "#/$defs/set_command"},
        {"$ref": "#/$defs/clear_command"}
      ]
    }
  },
  "$defs": {
    "paragraph_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_state_ids": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "set_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "paragraph_ids", "expected_state_ids", "value"],
      "properties": {
        "kind": {"const": "set_paragraph_alignment_override"},
        "paragraph_ids": {"$ref": "#/$defs/paragraph_ids"},
        "expected_state_ids": {"$ref": "#/$defs/expected_state_ids"},
        "value": {"enum": ["left", "center", "right"]}
      }
    },
    "clear_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "paragraph_ids", "expected_state_ids"],
      "properties": {
        "kind": {"const": "clear_paragraph_alignment_override"},
        "paragraph_ids": {"$ref": "#/$defs/paragraph_ids"},
        "expected_state_ids": {"$ref": "#/$defs/expected_state_ids"}
      }
    }
  }
}
