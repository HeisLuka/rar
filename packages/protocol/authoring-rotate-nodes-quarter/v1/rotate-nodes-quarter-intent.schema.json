{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptera.local/protocol/authoring-rotate-nodes-quarter/v1/rotate-nodes-quarter-intent.schema.json",
  "title": "Chaptera RotateNodesQuarterTurn intent V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_id",
    "source_hash",
    "base_revision_id",
    "client_operation_id",
    "command"
  ],
  "properties": {
    "protocol_version": {
      "const": "chaptera.rotate-nodes-quarter-intent.v1"
    },
    "document_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_revision_id": {"type": "string", "minLength": 1},
    "client_operation_id": {"type": "string", "minLength": 1},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page_id",
        "entries",
        "pivot_policy",
        "quarter_turns"
      ],
      "properties": {
        "kind": {"const": "rotate_nodes_quarter_turn"},
        "page_id": {"type": "string", "minLength": 1},
        "entries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "expected_before"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "expected_before": {"$ref": "#/$defs/exact_affine"}
            }
          }
        },
        "pivot_policy": {
          "const": "per_node_authored_bounds_center"
        },
        "quarter_turns": {
          "type": "integer",
          "not": {"multipleOf": 4}
        }
      }
    }
  },
  "$defs": {
    "linear": {"type": "string", "enum": ["-1", "0", "1"]},
    "exact_half_emu": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.5)?$"
    },
    "exact_affine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "c", "d", "tx", "ty"],
      "properties": {
        "a": {"$ref": "#/$defs/linear"},
        "b": {"$ref": "#/$defs/linear"},
        "c": {"$ref": "#/$defs/linear"},
        "d": {"$ref": "#/$defs/linear"},
        "tx": {"$ref": "#/$defs/exact_half_emu"},
        "ty": {"$ref": "#/$defs/exact_half_emu"}
      }
    }
  }
}
