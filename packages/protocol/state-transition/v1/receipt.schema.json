{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptera.example/protocol/state-transition/v1/receipt.schema.json",
  "title": "Chaptera state transition receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "contract",
    "system",
    "fixture",
    "comparison",
    "before",
    "operation",
    "after",
    "invariants"
  ],
  "properties": {
    "receipt_version": {
      "const": "chaptera.state-transition-receipt.v1"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[0-9A-Za-z._:/+-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z._+-]+$"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runtime", "build"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "provenance"],
      "properties": {
        "kind": {
          "enum": ["synthetic", "public", "sanitized_private", "native_oracle"]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_state_fields", "required_invariants"],
      "properties": {
        "required_state_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[0-9A-Za-z._:/+-]+$"
          }
        },
        "required_invariants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[0-9A-Za-z._:/+-]+$"
          }
        }
      }
    },
    "before": { "$ref": "#/$defs/state" },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "inputs"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "inputs": {
          "type": "object"
        }
      }
    },
    "after": { "$ref": "#/$defs/state" },
    "invariants": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/evidenceField" }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/evidenceField" }
        }
      }
    },
    "evidenceField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "known" },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unknown" },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      ]
    }
  }
}
