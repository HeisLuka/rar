{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptera.local/protocol/authoring-paste-fragment/v1/paste-fragment-intent.schema.json",
  "title": "Chaptera PasteFragment intent V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "document_id", "source_hash", "base_revision_id", "client_operation_id", "command"],
  "properties": {
    "protocol_version": {"const": "chaptera.paste-fragment-intent.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_revision_id": {"type": "string", "minLength": 1},
    "client_operation_id": {"type": "string", "minLength": 1},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fragment", "identity_map", "destination", "placement"],
      "properties": {
        "kind": {"const": "paste_fragment"},
        "fragment": {"$ref": "#/$defs/fragment"},
        "identity_map": {"$ref": "#/$defs/identity_map"},
        "destination": {"$ref": "#/$defs/destination"},
        "placement": {"$ref": "#/$defs/placement"}
      }
    }
  },
  "$defs": {
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b"],
      "properties": {
        "r": {"type": "integer", "minimum": 0, "maximum": 255},
        "g": {"type": "integer", "minimum": 0, "maximum": 255},
        "b": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "color"],
      "properties": {
        "visible": {"type": "boolean"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "color", "width_emu"],
      "properties": {
        "visible": {"type": "boolean"},
        "color": {"$ref": "#/$defs/color"},
        "width_emu": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        "y": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        "width": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "height": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_node_id"],
      "properties": {
        "source_node_id": {"type": "string", "minLength": 1}
      }
    },
    "rectangle_fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment_entity_id", "bounds", "fill", "stroke"],
      "properties": {
        "fragment_entity_id": {"const": "entity:0"},
        "bounds": {"$ref": "#/$defs/rect"},
        "fill": {"$ref": "#/$defs/fill"},
        "stroke": {"$ref": "#/$defs/stroke"},
        "source_provenance": {"$ref": "#/$defs/source_provenance"}
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "rectangle"],
      "properties": {
        "schema_version": {"const": "chaptera.authoring-fragment.v1"},
        "rectangle": {"$ref": "#/$defs/rectangle_fragment"}
      }
    },
    "identity_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment_entity_id", "destination_node_id"],
      "properties": {
        "fragment_entity_id": {"const": "entity:0"},
        "destination_node_id": {"$ref": "#/$defs/uuid_v7"}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page_id"],
      "properties": {
        "kind": {"const": "page"},
        "page_id": {"type": "string", "minLength": 1}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dx_emu", "dy_emu"],
      "properties": {
        "kind": {"const": "translate"},
        "dx_emu": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        "dy_emu": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
      }
    }
  }
}