{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptera.local/protocol/authoring-table-cell-paint/v1/clear-table-cell-border-side-intent.schema.json",
  "title": "Chaptera ClearTableCellBorderSide intent V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "document_id", "source_hash", "base_revision_id", "client_operation_id", "command"],
  "properties": {
    "protocol_version": {"const": "chaptera.table-cell-border-side-clear-intent.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_revision_id": {"type": "string", "minLength": 1},
    "client_operation_id": {"type": "string", "minLength": 1},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "table_cell_id", "side", "expected_before"],
      "properties": {
        "kind": {"const": "clear_table_cell_border_side"},
        "table_cell_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "side": {"enum": ["top", "right", "bottom", "left"]},
        "expected_before": {"$ref": "#/$defs/border"}
      }
    }
  },
  "$defs": {
    "color": {
        "type": "object",
        "additionalProperties": false,
        "required": ["r", "g", "b"],
        "properties": {
          "r": {"type": "integer", "minimum": 0, "maximum": 255},
          "g": {"type": "integer", "minimum": 0, "maximum": 255},
          "b": {"type": "integer", "minimum": 0, "maximum": 255}
        }
      },
    "border": {
        "type": "object",
        "additionalProperties": false,
        "required": ["visible", "color", "width_emu"],
        "properties": {
          "visible": {"type": "boolean"},
          "color": {"$ref": "#/$defs/color"},
          "width_emu": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        }
      }
  }
}