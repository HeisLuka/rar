{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptera.dev/schema/authoring-textframe-columns/v1/layout-runtime-receipt.schema.json",
  "title": "Chaptera TextFrame columns authoritative layout runtime receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "producer", "source_hash", "story_id", "frame_node_id", "canonical_edit", "states", "invariants"],
  "properties": {
    "receipt_version": {"const": "chaptera.text-frame-columns-layout-receipt.v1"},
    "producer": {"$ref": "#/$defs/producer"},
    "source_hash": {"$ref": "#/$defs/sha256"},
    "story_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "frame_node_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "canonical_edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"$ref": "#/$defs/columns"},
        "after": {"$ref": "#/$defs/columns"}
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "accepted", "undo", "redo", "replay"],
      "properties": {
        "baseline": {"$ref": "#/$defs/layoutState"},
        "accepted": {"$ref": "#/$defs/layoutState"},
        "undo": {"$ref": "#/$defs/layoutState"},
        "redo": {"$ref": "#/$defs/layoutState"},
        "replay": {"$ref": "#/$defs/layoutState"}
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_write_count",
        "linked_frame_flow_used",
        "autofit_mutation_count",
        "vertical_text_used",
        "wrap_obstacles_used",
        "raw_story_text_emitted"
      ],
      "properties": {
        "source_write_count": {"const": 0},
        "linked_frame_flow_used": {"const": false},
        "autofit_mutation_count": {"const": 0},
        "vertical_text_used": {"const": false},
        "wrap_obstacles_used": {"const": false},
        "raw_story_text_emitted": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column_count", "gutter_emu"],
      "properties": {
        "column_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "gutter_emu": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "commit_or_build", "core_integration"],
      "properties": {
        "implementation": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 128},
        "commit_or_build": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "minLength": 1, "maxLength": 160},
        "core_integration": {"const": true}
      }
    },
    "layoutState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column_count",
        "gutter_emu",
        "story_hash",
        "frame_bounds_hash",
        "line_region_hash",
        "flow_hash",
        "overset_state",
        "overflow_recomputed",
        "environment_authoritative",
        "layout_environment_hash"
      ],
      "properties": {
        "column_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "gutter_emu": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "story_hash": {"$ref": "#/$defs/hashId"},
        "frame_bounds_hash": {"$ref": "#/$defs/hashId"},
        "line_region_hash": {"$ref": "#/$defs/hashId"},
        "flow_hash": {"$ref": "#/$defs/hashId"},
        "overset_state": {"enum": ["fits", "overset"]},
        "overflow_recomputed": {"const": true},
        "environment_authoritative": {"const": true},
        "layout_environment_hash": {"$ref": "#/$defs/hashId"}
      }
    }
  }
}
