{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptera.example/protocol/authoring-textframe-columns/v1/set-text-frame-columns-intent.schema.json",
  "title": "Chaptera SetTextFrameColumns intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_id",
    "source_hash",
    "base_revision_id",
    "client_operation_id",
    "command"
  ],
  "properties": {
    "protocol_version": {"const": "chaptera.text-frame-columns-intent.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_revision_id": {"type": "string", "minLength": 1},
    "client_operation_id": {"type": "string", "minLength": 8},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_id", "expected_before", "after"],
      "properties": {
        "kind": {"const": "set_text_frame_columns"},
        "node_id": {"type": "string", "minLength": 1},
        "expected_before": {"$ref": "#/$defs/columns_state"},
        "after": {"$ref": "#/$defs/columns_state"}
      }
    }
  },
  "$defs": {
    "columns_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column_count", "gutter_emu"],
      "properties": {
        "column_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "gutter_emu": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
